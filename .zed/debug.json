[
    {
        "label": "C++: Build and Debug",
        "adapter": "CodeLLDB",
        "request": "launch",
        "program": "$ZED_DIRNAME/$ZED_STEM",
        "cwd": "$ZED_DIRNAME",
        "build": {
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-g",
                "-Wall",
                "-Wextra",
                "$ZED_FILE",
                "-o",
                "$ZED_DIRNAME/$ZED_STEM",
                "-I",
                "$HOME/lib/ac-library"
            ],
            "cwd": "$ZED_DIRNAME"
        }
    }
]
